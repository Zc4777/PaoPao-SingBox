config paopaodns 'main'
	option enabled '1'
	option recursive '127.0.0.1:53'
	option encrypted '127.0.0.1:53'
	option ipv6 'raw'
	option memory_limit_mib '0'
	option cache_file_mib '4'
	option custom_ip 'ipv4'
	option cache_max_ttl '600'
	option timeout_ms '2000'
	option concurrency '64'
	option rules_dir '/etc/paopaodns-rs'
	option recursive_only '0'
	option allow_service_records '0'
	# option mmdb '/etc/paopaodns-rs/Country-only-cn-private.mmdb'
	# option global_mark '/etc/paopaodns-rs/global_mark.txt'
	# option cn_mark '/etc/paopaodns-rs/cn_mark.txt'
	# option custom_forward '127.0.0.1:1053'
	# option cn_fallback '223.5.5.5:53'
