'use strict';

import { lstat, mkdtemp, popen, readfile, rename, rmdir, unlink, writefile } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';

const NAME = 'paopaodns-rs';
const INIT = '/etc/init.d/paopaodns-rs';
const BINARY = '/usr/sbin/paopaodns-rs';
const RULE_DIR = '/etc/paopaodns-rs';
const MAX_RULE_BYTES = 65536;
const RESPONSE_STATS = '/var/run/paopaodns-rs-stats.json';
const GEO_UPDATE = '/bin/sh /usr/libexec/paopaodns-rs-update-mmdb';
const DATA_UPDATE_STATUS = '/var/run/paopaodns-rs-update';

function error(message) {
    return { ok: false, error: message };
}

function run(command) {
    const stream = popen(command + ' 2>&1');
    if (!stream)
        return error('无法执行请求');
    const result = trim(stream.read('all') ?? '');
    const rc = stream.close();
    return rc === 0 ? { ok: true } : error(result || '命令执行失败');
}

function instance() {
    const connection = connect();
    if (!connection)
        return null;
    const services = connection.call('service', 'list', { name: NAME });
    connection.disconnect();
    return services?.[NAME]?.instances?.main ?? services?.[NAME]?.instances?.instance1;
}

function read_logs(kind, page) {
    const query = kind == 'queries';
    if (!query && kind != null && kind != 'service')
        return error('未知的日志类型');

    const service = instance();
    const pid = service?.pid;
    if (!service?.running || type(pid) != 'int' || pid <= 0)
        return { ok: true, text: '', total: 0, page: 1, pages: 1 };

    const logread = sprintf("/sbin/logread -e '^paopaodns-rs\\[%d\\]:' 2>/dev/null", pid);
    const predicate = query ? '/: query client=/' : '!/: query client=/';
    const command = "set -o pipefail; " + logread + " | /usr/bin/awk '" + predicate + "' | /usr/bin/tail -n 500";
    const stream = popen(command);
    if (!stream)
        return error('无法读取服务日志');
    const text = trim(stream.read('all') ?? '');
    if (stream.close() !== 0)
        return error('无法读取系统日志缓冲区');
    const entries = text ? split(text, '\n') : [];
    if (page == null || page <= 0)
        return { ok: true, text, total: length(entries) };
    const lines = reverse(entries);
    const pages = max(1, int((length(lines) + LOG_PAGE_SIZE - 1) / LOG_PAGE_SIZE));
    const current = min(pages, max(1, int(page ?? 1)));
    const offset = (current - 1) * LOG_PAGE_SIZE;
    return {
        ok: true, page: current, pages, total: length(lines),
        text: join('\n', slice(lines, offset, offset + LOG_PAGE_SIZE))
    };
}

function data_update_status() {
    const file = lstat(DATA_UPDATE_STATUS);
    if (!file)
        return null;
    const report = trim(readfile(DATA_UPDATE_STATUS, 4096) ?? '');
    if (!report)
        return null;
    const lines = split(report, '\n');
    if (lines[0] == 'done') {
        const age = time() - file.mtime;
        if (age < 0 || age >= 5)
            return null;
    }
    return { state: lines[0], message: join(' · ', slice(lines, 1)) };
}

function status() {
    const data_update = data_update_status();
    const service = instance();
    if (!service?.running || type(service.pid) != 'int' || service.pid <= 0)
        return { running: false, data_update };
    const statusFile = readfile(sprintf('/proc/%d/status', service.pid)) ?? '';
    const limitsFile = readfile(sprintf('/proc/%d/limits', service.pid)) ?? '';
    let rss = null;
    let limit = null;
    for (let line in split(statusFile, '\n')) {
        const memory = match(line, /^VmRSS:[ \t]+([0-9]+)/);
        if (memory)
            rss = int(memory[1]);
    }
    for (let line in split(limitsFile, '\n')) {
        const cap = match(line, /^Max address space[ \t]+([^ \t]+)/);
        if (cap)
            limit = cap[1] == 'unlimited' ? 0 : int(cap[1]);
    }
    const report = readfile(RESPONSE_STATS, 1024);
    const latency = report ? json(report) : null;
    return { running: true, pid: service.pid, rss_kib: rss, limit_bytes: limit, data_update,
        latency: latency?.pid == service.pid ? latency : null };
}

function rule_name(id) {
    switch (id) {
    case 'forward': return 'force_forward_list.txt';
    case 'encrypted': return 'force_dnscrypt_list.txt';
    case 'recursive': return 'force_recurse_list.txt';
    default: return null;
    }
}

function is_default_rule_dir() {
    const uci = cursor();
    const dir = uci.get(NAME, 'main', 'rules_dir') ?? RULE_DIR;
    return dir == RULE_DIR || dir == RULE_DIR + '/';
}

function read_rule(id) {
    const name = rule_name(id);
    if (!name || !is_default_rule_dir())
        return error('文件编辑器只管理默认目录中的三个分流规则文件');
    const path = RULE_DIR + '/' + name;
    const info = lstat(path);
    if (info && (info.type != 'file' || info.size > MAX_RULE_BYTES))
        return error('规则文件类型无效或超过 64 KiB');
    const text = info ? readfile(path, MAX_RULE_BYTES + 1) : '';
    if (text === null || length(text) > MAX_RULE_BYTES)
        return error('无法读取规则文件');
    return { ok: true, text };
}

function write_rule(id, text) {
    const name = rule_name(id);
    if (!name || !is_default_rule_dir())
        return error('文件编辑器只管理默认目录中的三个分流规则文件');
    if (type(text) != 'string' || length(text) > MAX_RULE_BYTES)
        return error('规则文件上限为 64 KiB');

    const current = lstat(RULE_DIR + '/' + name);
    if (current && (current.type != 'file' || current.size > MAX_RULE_BYTES))
        return error('规则文件类型无效或超过 64 KiB');

    const directory = mkdtemp(RULE_DIR + '/.luci.XXXXXX');
    if (!directory)
        return error('无法创建规则校验目录');
    const staged = directory + '/' + name;
    let result;
    if (writefile(staged, text) !== length(text)) {
        result = error('无法写入规则文件');
    } else {
        // Only the literal template above can supply directory path components.
        result = run(BINARY + ' --check --rules-dir ' + directory);
        if (result.ok && !rename(staged, RULE_DIR + '/' + name))
            result = error('无法替换规则文件');
    }
    unlink(staged);
    rmdir(directory);

    if (result.ok && instance()?.running) {
        const reload = run(INIT + ' reload');
        if (!reload.ok)
            result.warning = '规则已保存，应用失败。' + reload.error;
    }
    return result;
}

return {
    'luci.paopaodns': {
        status: { call: status },
        readLogs: {
            args: { kind: '', page: 0 },
            call: function(request) {
                return read_logs(request.args.kind, request.args.page);
            }
        },
        updateAddressDb: { call: () => run(GEO_UPDATE) },
        serviceAction: {
            args: { action: '' },
            call: function(request) {
                switch (request.args.action) {
                case 'stop':
                    return run(INIT + ' stop');
                case 'start':
                case 'restart':
                    const check = run(INIT + ' check_config');
                    if (!check.ok)
                        return check;
                    return run('PAOPAODNS_MANUAL_START=1 ' + INIT + ' ' + request.args.action);
                default:
                    return error('未知的服务操作');
                }
            }
        },
        readRule: {
            args: { rule: '' },
            call: function(request) {
                return read_rule(request.args.rule);
            }
        },
        writeRule: {
            args: { rule: '', text: '' },
            call: function(request) {
                return write_rule(request.args.rule, request.args.text);
            }
        }
    }
};
