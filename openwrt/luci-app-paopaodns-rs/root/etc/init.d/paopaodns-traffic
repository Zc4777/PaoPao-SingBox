#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only

USE_PROCD=1
START=76
STOP=19

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
        umask 077
        while :; do
            /usr/libexec/paopaodns-proxy-traffic
            sleep 300
        done'
    procd_set_param respawn
    procd_close_instance
}
